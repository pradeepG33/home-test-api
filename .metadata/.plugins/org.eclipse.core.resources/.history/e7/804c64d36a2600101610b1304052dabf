Feature: Inventory API tests

Background:
* url 'http://localhost:3100/api'

Scenario: Get all menu items
Given path 'inventory'
When method GET
Then status 200
And assert response.data.length >= 9

Scenario: Filter by ID
Given path 'inventory', 'filter'
And param id = 3
When method GET
Then status 200
# API returns id as string
And match response.id == '3'
And match response.name == 'Baked Rolls x 8'
# price for ID 3 is $10
And match response.price == '$10'
And match response.image == 'roll.png'

Scenario: Add item with new ID
Given path 'inventory', 'add'
And request { id: '12', name: 'car', image: 'hawaiian.png', price: '$20' }
When method POST
Then status 200

Scenario: Add item with existing ID
Given path 'inventory', 'add'
And request { id: 10, name: 'Hawaiian', image: 'hawaiian.png', price: '$14' }
When method POST
Then status 400

Scenario: Add item with missing info
Given path 'inventory', 'add'
And request { name: 'Missing ID', image: 'missing.png', price: '$10' }
When method POST
Then status 400
# error returns plain text
And match response == 'Not all requirements are met'

Scenario: Validate recently added item is present
Given path 'inventory'
When method GET
Then status 200
# items now wrapped under data
And match response.data contains { id: 10, name: 'Hawaiian', image: 'hawaiian.png', price: '$14' }










   

    